<?xml version="1.0"?>
<package format="3">
  <name>rog_map_ros2</name>
  <version>0.1.0</version>
  <description>ROS 2 Humble port of ROG-Map: a robot-centric 3D occupancy and inflated collision map.</description>

  <maintainer email="renyf@connect.hku.hk">yunfan.ren</maintainer>
  <maintainer email="kangneng@example.com">kangneng</maintainer>
  <license>LGPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
