# syntax=docker/dockerfile:1.7
#
# ARM64 构建（在本文件所在目录执行）：
# docker buildx build --platform linux/arm64 --load -t cross-floor-nav:arm64-v1 -f Dockerfile.arm64 .
#
# ARM64 运行：
# docker run --rm -it --name kn-nav-arm64 --network host --ipc host --privileged \
#   -v /实际地图目录:/home/nav_map:ro cross-floor-nav:arm64-v1
#
# 后台运行：
# docker run -d --name kn-nav-arm64 --restart unless-stopped \
#   --network host --ipc host --privileged \
#   -v /实际地图目录:/home/nav_map:ro cross-floor-nav:arm64-v1 sleep infinity
#
# 进入后台容器：
# docker exec -it kn-nav-arm64 bash
#
# 导出 / 导入：
# docker save -o cross-floor-nav-arm64-v1.tar cross-floor-nav:arm64-v1
# docker load -i cross-floor-nav-arm64-v1.tar
#
FROM ros:humble-ros-base-jammy

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ARG TARGETARCH
ARG DEBIAN_FRONTEND=noninteractive
ARG BUILD_JOBS=4
ARG KN_NAV_REPO=https://github.com/zhangaoheng/kn_nav.git
ARG KN_NAV_REF=d17706e8844370da1b33875fbd576920784a4afa
ARG UNITREE_SDK2_REF=21d0a3b2c46ee48c8fdf2783becb6be3beb0a59b
ARG LIVOX_SDK2_REF=f5d9375f84efe2b15bc0a052d3e18482ed13adf4
ARG LIVOX_ROS_DRIVER2_REF=v1.1.3

RUN test "${TARGETARCH}" = arm64

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates cmake git pkg-config unzip vim \
      libapr1-dev libboost-all-dev libc++-11-dev libc++abi-11-dev \
      libeigen3-dev libfmt-dev libgl1-mesa-dev libopencv-dev \
      libopen3d-dev libpcl-dev libspdlog-dev libtbb-dev libx11-dev \
      libyaml-cpp-dev \
      python3-colcon-common-extensions python3-dev python3-numpy \
      python3-open3d python3-pip python3-rosdep python3-scipy \
      ros-humble-ament-cmake-python ros-humble-cv-bridge \
      ros-humble-eigen3-cmake-module ros-humble-foxglove-bridge \
      ros-humble-image-transport ros-humble-pcl-ros \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /home/code/thirdparty /home/code/work_space/ws_livox/src /tmp/ros_logs \
    && git clone https://github.com/unitreerobotics/unitree_sdk2.git /home/code/thirdparty/unitree_sdk2 \
    && git -C /home/code/thirdparty/unitree_sdk2 checkout "${UNITREE_SDK2_REF}" \
    && test -f /home/code/thirdparty/unitree_sdk2/lib/aarch64/libunitree_sdk2.a \
    && git clone https://github.com/Livox-SDK/Livox-SDK2.git /home/code/thirdparty/Livox-SDK2 \
    && git -C /home/code/thirdparty/Livox-SDK2 checkout "${LIVOX_SDK2_REF}" \
    && git clone https://github.com/Livox-SDK/livox_ros_driver2.git /home/code/work_space/ws_livox/src/livox_ros_driver2 \
    && git -C /home/code/work_space/ws_livox/src/livox_ros_driver2 checkout "${LIVOX_ROS_DRIVER2_REF}" \
    && git clone "${KN_NAV_REPO}" /home/code/work_space/kn_nav \
    && git -C /home/code/work_space/kn_nav checkout "${KN_NAV_REF}" \
    && find /home/code -type d -name .git -prune -exec rm -rf {} +

RUN cmake -S /home/code/thirdparty/unitree_sdk2 -B /home/code/thirdparty/unitree_sdk2/build \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/unitree_robotics \
      -DBUILD_EXAMPLES=OFF \
    && cmake --build /home/code/thirdparty/unitree_sdk2/build --parallel "${BUILD_JOBS}" \
    && cmake --install /home/code/thirdparty/unitree_sdk2/build

RUN cmake -S /home/code/thirdparty/Livox-SDK2 -B /home/code/thirdparty/Livox-SDK2/build \
      -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /home/code/thirdparty/Livox-SDK2/build --parallel "${BUILD_JOBS}" \
    && cmake --install /home/code/thirdparty/Livox-SDK2/build \
    && ldconfig

RUN source /opt/ros/humble/setup.bash \
    && cd /home/code/work_space/ws_livox \
    && colcon build --symlink-install --cmake-args \
      -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
      -DROS_EDITION=ROS2 -DHUMBLE_ROS=humble

RUN cd /home/code/work_space/kn_nav/src/PCT_planner/planner \
    && bash build_thirdparty.sh \
    && bash build.sh

RUN source /opt/ros/humble/setup.bash \
    && source /home/code/work_space/ws_livox/install/setup.bash \
    && export CMAKE_PREFIX_PATH="/opt/unitree_robotics:${CMAKE_PREFIX_PATH:-}" \
    && export LD_LIBRARY_PATH="/opt/unitree_robotics/lib:/usr/local/lib:${LD_LIBRARY_PATH:-}" \
    && cd /home/code/work_space/kn_nav \
    && colcon build --symlink-install --cmake-args \
      -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
      -DOpen3D_DIR=/usr/lib/aarch64-linux-gnu/cmake/Open3D

COPY docker-entrypoint-arm64.sh /usr/local/bin/kn-nav-entrypoint-arm64
RUN chmod +x /usr/local/bin/kn-nav-entrypoint-arm64

ENV ROS_LOG_DIR=/tmp/ros_logs \
    Open3D_DIR=/usr/lib/aarch64-linux-gnu/cmake/Open3D

WORKDIR /home/code/work_space/kn_nav
ENTRYPOINT ["/usr/local/bin/kn-nav-entrypoint-arm64"]
CMD ["bash"]
